{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build projeto completo",
            "command": "gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-Wall",
                "-Wextra",
                "-g3",
                "${fileDirname}/main.c",
                "${fileDirname}/alunos.c",
                "${fileDirname}/disciplinas.c",
                "${fileDirname}/medias.c",
                "${fileDirname}/notas.c",
                "-o",
                "${fileDirname}/output/main.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila todos os arquivos do projeto (main, alunos, disciplinas, medias, notas)."
        }
    ],
    "version": "2.0.0"
}